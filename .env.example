# Copy to .env for local development. Never commit the real .env file.
# On AWS, set these via `eb setenv` (see README.md) instead of a file.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. On AWS, point at RDS Postgres:
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Static/media storage. Leave False for local dev (served from disk).
# Set True on AWS to serve from S3 via django-storages.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

DJANGO_LOG_LEVEL=INFO

# Optional. Required for UPCitemdb paid /prod/v1 lookup; leave blank for trial-only use.
UPCITEMDB_USER_KEY=

# Required for Go-UPC lookups. Request a free trial at https://go-upc.com/plans/api/trial
GO_UPC_API_KEY=
