# Runs on every deploy, on the leader instance only (single-instance env
# has exactly one, so this always runs). Applies pending migrations and
# gathers static files into the S3 bucket configured via USE_S3/AWS_* env
# vars before gunicorn (see Procfile) starts serving traffic.
container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"

option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: hhinventory.settings
