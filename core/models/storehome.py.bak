from django.db import models


class Storehome(models.Model):
    name = models.CharField(max_length=255)
    address = models.CharField(max_length=255)
    
class StorehomeUsers(models.Model):
    storehome = models.ForeignKey("core.Storehome", verbose_name="Storehome", on_delete=models.PROTECT)
    user_profile = models.ForeignKey("core.UserProfile", verbose_name="User", on_delete=models.PROTECT)
    can_manage_inventory = models.BooleanField(default=False, verbose_name="Can Manage Inventory")
